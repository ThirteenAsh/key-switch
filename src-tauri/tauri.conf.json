{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Key Switch",
  "version": "1.0.0-rc",
  "identifier": "com.app.key-switch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Key Switch",
        "width": 900,
        "height": 650,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "windows": {
      "wix": {
        "version": "1.0.0.1"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0MjhBQzBGQ0VBMEZBMUMKUldRYytxRE9ENndvMUNzeE92WTNqZjdLK0dhNTY0T2RRdjhDcXpFVEYybktra2tsbk83c2pQMGoK",
      "endpoints": []
    }
  }
}
